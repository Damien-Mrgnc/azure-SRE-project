              {
                "searchQuery": "AppServiceHTTPLogs | where TimeGenerated > ago(10m) | summarize p99 = percentile(TimeTaken, 99) | where p99 > 800",
                "metricValue": 1,
                "windowStartTime": "2026-04-13T10:35:00Z",
                "windowEndTime": "2026-04-13T10:45:00Z"
              }
            ]
